PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Firebase (consola de Firebase > Configuración del proyecto > Cuentas de servicio > Generar clave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OTP (en segundos — debe coincidir con el contador del frontend)
OTP_EXPIRES_IN_SECONDS=60

# n8n (URL del webhook que dispara el envio del correo con el OTP)
N8N_WEBHOOK_URL=
